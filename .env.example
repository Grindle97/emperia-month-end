# Emperia month-end close agent. Copy to .env and fill in.
# This project is for Emperia ONLY: use a Xero app created for it, never
# credentials or tokens from another client's project.

# --- Xero app (developer.xero.com > My Apps > New app: "Web app") ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Must match the redirect URI registered on the Xero app exactly.
XERO_REDIRECT_URI=http://localhost:3000/auth/xero/callback

# Phase 1 is READ-ONLY. Do not add accounting.manualjournals (write) until
# phase 3; doctor warns if a write scope is present.
XERO_SCOPES=offline_access openid profile email accounting.settings.read accounting.reports.trialbalance.read accounting.reports.balancesheet.read accounting.reports.banksummary.read accounting.banktransactions.read accounting.invoices.read accounting.payments.read accounting.manualjournals.read assets.read

# The two organisations exactly as Xero names them. Only change these if
# doctor says the names don't match. Any other organisation on the
# connection makes the agent refuse to run.
XERO_ORG_NAME_LTD=Emperia
XERO_ORG_NAME_INC=Emperia VR Inc

# --- Dashboard sign-in ---
# Who may use the dashboard: email:role pairs. Roles: admin (RORA), approver
# (approves journals, signs off), preparer (the analyst: runs the close,
# enters inputs, explains, ticks), viewer (read only).
USER_ROLES=reece@joinrora.com:admin
# Local only: signs you in without Cloudflare. Ignored when NODE_ENV=production.
DEV_USER_EMAIL=reece@joinrora.com
# Deployed: Cloudflare Access application settings (docs/DEPLOYMENT.md).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
PUBLIC_URL=
# Where registers, inputs, runs and decisions are kept. On Railway: the volume.
DATA_DIR=./data
# 1 = run on the Sep 2026 workbook balances instead of Xero (demo / training).
DEMO_MODE=

# --- Assistant (optional) ---
# Turns on "Ask" on journals and reading bank statements. Use an API key from
# an Emperia workspace in the Anthropic Console, not another client's.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# --- App ---
PORT=3000
# Where the Xero token is stored. Kept separate from any other project.
TOKEN_STORE_PATH=./data/xero-tokens-emperia.json
# Set before this ever runs anywhere other than your laptop.
AUTH_SETUP_TOKEN=
